<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:background="@color/background">

    <Button
        android:id="@+id/login_BTN_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/default_margin"
        app:cornerRadius="10dp"
        android:text="LOGIN"
        android:textSize="30sp"
        android:backgroundTint="@color/button"/>

    <EditText
        android:id="@+id/login_ETXT_Email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_above="@id/login_ETXT_Password"
        android:layout_centerVertical="true"
        android:layout_marginBottom="@dimen/default_margin"
        android:ems="10"
        android:textSize="30sp"
        android:inputType="textEmailAddress"
        android:background="@drawable/custom_border"/>

    <EditText
        android:id="@+id/login_ETXT_Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_centerVertical="true"
        android:textSize="30sp"
        android:background="@drawable/custom_border"
        android:ems="10"
        android:inputType="textPassword" />

    <ImageView
        android:id="@+id/login_IMG_logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/default_margin"
        android:layout_marginBottom="@dimen/default_margin"
        app:srcCompat="@drawable/match_logo" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_above="@id/login_ETXT_Email"
        android:textSize="20sp"
        android:textColor="@color/text"
        android:text="Email" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/login_ETXT_Password"
        android:layout_marginStart="@dimen/default_margin"
        android:textSize="20sp"
        android:text="Password"
        android:textColor="@color/text"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp">
    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:text="Don't have an account?"
        android:textColor="@color/text"/>

    <TextView
        android:id="@+id/login_TXT_SignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/textView9"
        android:layout_marginStart="5dp"
        android:text="Sign Up"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

</RelativeLayout>