<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".RegisterActivity">

    <EditText
        android:id="@+id/register_ETXT_FullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/default_margin"
        android:ems="15"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_above="@id/register_ETXT_EmailAddress"
        android:background="@drawable/custom_border"
        android:textSize="30sp"
        android:inputType="text" />

    <EditText
        android:id="@+id/register_ETXT_Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:background="@drawable/custom_border"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:ems="10"
        android:textSize="30sp"
        android:layout_marginBottom="@dimen/default_margin"
        android:inputType="textPassword"/>

    <EditText
        android:id="@+id/register_ETXT_EmailAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="15"
        android:background="@drawable/custom_border"
        android:layout_marginBottom="@dimen/default_margin"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:inputType="textEmailAddress"
        android:textSize="30sp"
        android:layout_above="@id/register_ETXT_Password"/>

    <Button
        android:id="@+id/register_BTN_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/default_margin"
        app:cornerRadius="10dp"
        android:text="REGISTER"
        android:textSize="30sp"
        android:backgroundTint="@color/button"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/register_ETXT_FullName"
        android:layout_marginStart="@dimen/default_margin"
        android:text="Full Name"
        android:textColor="@color/text"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/register_ETXT_EmailAddress"
        android:layout_marginStart="@dimen/default_margin"
        android:textSize="20sp"
        android:text="Email"
        android:textColor="@color/text"/>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/register_ETXT_Password"
        android:layout_marginStart="@dimen/default_margin"
        android:textSize="20sp"
        android:text="Passsword"
        android:textColor="@color/text"/>

    <Spinner
        android:id="@+id/register_Spin_Israeli_Team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/register_ETXT_Password"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:layout_marginBottom="@dimen/default_margin"
        android:background="@drawable/custom_border"
        android:minHeight="40dp"
        android:entries="@array/israeli_teams"
        />

    <Spinner
        android:id="@+id/register_Spin_National_Team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/register_Spin_Israeli_Team"
        android:background="@drawable/custom_border"
        android:minHeight="40dp"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:entries="@array/national_teams"
        />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/register_Spin_Israeli_Team"
        android:layout_marginStart="@dimen/default_margin"
        android:textSize="20sp"
        android:text="Favorite team in Israel"
        android:textColor="@color/text"/>

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/register_Spin_National_Team"
        android:layout_marginStart="@dimen/default_margin"
        android:textSize="20sp"
        android:text="Favorite National team"
        android:textColor="@color/text"/>


    <ImageButton
        android:id="@+id/register_BTN_back"
        android:layout_width="60dp"
        android:layout_height = "60dp"
        app:srcCompat="@drawable/back_arrow"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginTop="@dimen/default_margin"
        android:scaleType="fitCenter"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:textStyle="bold"
        android:layout_above="@id/register_ETXT_FullName"
        android:layout_marginBottom="@dimen/default_margin"
        android:layout_centerHorizontal="true"
        android:text="New Account"

        android:textColor="@color/text"/>



</RelativeLayout>