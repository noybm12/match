<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    android:backgroundTint="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/match_TXT_league"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_league"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            tools:text="League Name"
            android:textColor="#00BCD4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/match_TXT_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Date placeholder"
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/match_TXT_league"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/match_TXT_league" />

        <ImageView
            android:id="@+id/match_IMG_team1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="#FFF3E0"
            app:layout_constraintEnd_toEndOf="@+id/match_TXT_league"
            app:layout_constraintStart_toStartOf="@+id/match_TXT_league"
            app:layout_constraintTop_toBottomOf="@+id/match_TXT_league" />

        <TextView
            android:id="@+id/match_TXT_team1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Team 1"
            android:textColor="#2C2C2C"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/match_IMG_team1"
            app:layout_constraintStart_toStartOf="@+id/match_IMG_team1"
            app:layout_constraintTop_toBottomOf="@+id/match_IMG_team1" />

        <!-- תמונה קבוצה 2 -->
        <ImageView
            android:id="@+id/match_IMG_team2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#E3F2FD"
            app:layout_constraintEnd_toEndOf="@+id/match_TXT_date"
            app:layout_constraintStart_toStartOf="@+id/match_TXT_date"
            app:layout_constraintTop_toTopOf="@+id/match_IMG_team1" />

        <TextView
            android:id="@+id/match_TXT_team2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Team 2"
            android:textColor="#2C2C2C"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/match_IMG_team2"
            app:layout_constraintStart_toStartOf="@+id/match_IMG_team2"
            app:layout_constraintTop_toBottomOf="@+id/match_IMG_team2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/match_IMG_team1"
            app:layout_constraintEnd_toStartOf="@+id/match_IMG_team2"
            app:layout_constraintStart_toEndOf="@+id/match_IMG_team1"
            app:layout_constraintTop_toTopOf="@+id/match_IMG_team1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textColor="#191A23"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/match_TXT_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="00:00"
                android:textColor="#00BCD4"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/match_LAY_watch_parties"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E0F7FA"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/match_TXT_team1_name">

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>